# ----------------------------------------------------------------------------
# Finova - local environment configuration
# Copy to `.env` (git-ignored) and adjust. `docker compose` reads this file
# automatically when it is present. No real credentials belong in this file:
# everything below is a local-development placeholder.
# ----------------------------------------------------------------------------

# ---- Secrets (override in any real environment) ----
JWT_SECRET=finova-local-development-secret-key-change-me-32bytes
JWT_ISSUER=finova
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# ---- PostgreSQL ----
POSTGRES_USER=finova
POSTGRES_PASSWORD=finova
POSTGRES_DB=finova_users
DB_HOST=postgres
DB_PORT=5432
DB_NAME=finova_users
DB_USER=finova
DB_PASSWORD=finova

# Per-service databases created on the shared Postgres instance
ACCOUNT_DB_NAME=finova_accounts
TRANSACTION_DB_NAME=finova_transactions
NOTIFICATION_DB_NAME=finova_notifications

# ---- MongoDB (fraud detection) ----
MONGO_INITDB_ROOT_USERNAME=finova
MONGO_INITDB_ROOT_PASSWORD=finova
MONGODB_URI=mongodb://finova:finova@mongodb:27017/finova_fraud?authSource=admin

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_NODE_ID=1
CLUSTER_ID=finova-local-cluster-01

# ---- Service discovery ----
EUREKA_URL=http://discovery-server:8761/eureka/
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/

# ---- Gateway ----
GATEWAY_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# ---- Frontend ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
VITE_USE_MOCKS=true

# ---- Observability (ELK) ----
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_PORT=5000
KIBANA_URL=http://localhost:5601
STACK_VERSION=8.13.4

# ---- Spring profiles ----
SPRING_PROFILES_ACTIVE=dev
LOGGING_LEVEL_ROOT=INFO
