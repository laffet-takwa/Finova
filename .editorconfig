root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{java,kt,gradle,pom.xml}]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,jsonc,ndjson}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{vue,ts,tsx}]
indent_size = 2
max_line_length = 110

[*.css,*.scss]
indent_size = 2

[Makefile]
indent_style = tab

[*.sql]
indent_size = 4