<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared Finova console pattern: every line carries the service name and the
  request correlation id so Logstash can parse it. See
  docs/observability/logging-format.md. Do not diverge per service.
-->
<configuration>

    <springProperty scope="context" name="applicationName" source="spring.application.name"
                    defaultValue="finova"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [${applicationName},%X{correlationId:-}] %-40.40logger{39} : %m%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
