<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="SERVICE" value="${spring.application.name:-fraud-service}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level service=${SERVICE} correlationId=%X{correlationId:-none} method=%X{httpMethod:-none} path=%X{requestPath:-none} logger=%logger{36} message=%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.finova" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.mongodb.driver" level="WARN"/>
    <logger name="org.springframework.data.mongodb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>